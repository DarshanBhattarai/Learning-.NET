@page "/intro"

<div style="padding: 20px; text-align: center; font-family: Arial, sans-serif;">
    <h1 style="margin-bottom: 20px; color: #2c3e50;">Welcome to Itahari International College</h1>

    <div style="margin: 30px 0;">
        <!-- Use relative path for images inside wwwroot -->
        <img src="image/collage.png"
             alt="College Building"
             style="max-width: 100%; height: auto; border-radius: 12px;
                    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);" />
    </div>

    <p style="max-width: 800px; margin: 0 auto; font-size: 1.1em; line-height: 1.6; text-align: justify; color: #34495e;">
        Itahari International College is a premier educational institution dedicated to providing
        quality education and fostering innovation. Located in Itahari, Koshi Province, Nepal,
        our college offers a wide range of programs designed to prepare students for successful
        careers in today's dynamic world. With experienced faculty, modern facilities, and a
        commitment to excellence, we strive to nurture the next generation of leaders and
        professionals.
    </p>
</div>

